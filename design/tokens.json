{
  "version": "1.2.0",
  "status": "proposed-design-baseline",
  "description": "Semantic light-theme tokens. Dimensions are logical units; map dimensions to Compose dp and typography to sp. Validate browser equivalents separately.",
  "color": {
    "canvas": "#F4F6F8",
    "surface": "#FFFFFF",
    "surfaceSubtle": "#F8FAFC",
    "textPrimary": "#182230",
    "textSecondary": "#536174",
    "textMuted": "#64748B",
    "borderSubtle": "#DCE2E8",
    "borderControl": "#7A8796",
    "accent": "#087F73",
    "accentHover": "#06695F",
    "accentPressed": "#05564F",
    "accentTint": "#F1FAF8",
    "onAccent": "#FFFFFF",
    "focus": "#2563EB",
    "successText": "#067647",
    "successBg": "#ECFDF3",
    "warningText": "#92400E",
    "warningBg": "#FFFBEB",
    "dangerText": "#B42318",
    "dangerBg": "#FEF3F2",
    "infoText": "#175CD3",
    "infoBg": "#EFF8FF"
  },
  "typography": {
    "family": "IBM Plex Sans",
    "weights": { "regular": 400, "medium": 500, "semibold": 600 },
    "metadata": { "size": 14, "lineHeight": 20 },
    "compact": { "size": 14, "lineHeight": 20 },
    "body": { "size": 16, "lineHeight": 24 },
    "section": { "size": 18, "lineHeight": 24 },
    "pageTitle": { "size": 24, "lineHeight": 32 },
    "total": { "size": 40, "lineHeight": 48 },
    "customerTotal": { "size": 48, "lineHeight": 56 },
    "numericStyle": "tabular"
  },
  "spacing": [4, 8, 12, 16, 24, 32, 48],
  "radius": { "control": 8, "surface": 12, "overlay": 12 },
  "border": { "standard": 1, "focusWidth": 2, "focusOffset": 2 },
  "layout": {
    "navigationWidth": 208,
    "navigationMinLabelledWidth": 176,
    "contextBarHeight": 56,
    "fullscreenBarHeight": 40,
    "statusStripHeight": 36,
    "pagePadding": 24,
    "compactPagePadding": 16,
    "basketWidth": 380,
    "basketMinWidth": 320,
    "basketMaxWidth": 400,
    "detailPanelMinWidth": 400,
    "detailPanelMaxWidth": 480,
    "dialogMinWidth": 440,
    "dialogMaxWidth": 560
  },
  "density": {
    "standard": { "controlHeight": 44, "checkoutActionHeight": 56, "rowHeight": 52, "iconHitArea": 44, "productTileMinWidth": 156, "productTileMinHeight": 112 },
    "touch": { "controlHeight": 48, "checkoutActionHeight": 56, "rowHeight": 56, "iconHitArea": 48, "productTileMinWidth": 176, "productTileMinHeight": 128 },
    "compactReporting": { "controlHeight": 40, "rowHeight": 44, "description": "Explicit opt-in for reporting only; never applied to checkout automatically." }
  },
  "icons": { "family": "Lucide", "rowSize": 18, "standardSize": 20, "touchSize": 24, "strokeWidth": 2, "navigationSize": 20, "emptyStateSize": 28, "tileBackground": "accentTint" },
  "motionMs": { "feedback": 120, "expand": 160, "overlay": 180 },
  "locale": { "defaultCurrency": "NGN", "defaultTimezone": "Africa/Lagos", "defaultMoneyFractionDigits": 2 }
}
